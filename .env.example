# Mosaic AI — Multilingual Learning Companion for Notion
# Server-side Environment Configuration

# ==============================================================================
# NOTION OFFICIAL INTEGRATION (Server-side Only)
# ==============================================================================
# 1. Create an Internal Integration at: https://www.notion.so/profile/integrations
# 2. Capabilities required: Read content, Update content, Insert content.
# 3. Share your target Notion page or database with your integration:
#    In Notion: Click "..." at top right -> "Connect to" / "Add connections" -> Select "Mosaic AI".
# 4. Token format: starts with 'secret_' or 'ntn_'
NOTION_API_KEY=secret_your_notion_internal_integration_token

# Supabase PostgreSQL (Optional - for Notes Exchange persistence & sync)
# When omitted, Notes Exchange runs smoothly in explicitly labeled Demo Mode with sample notes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side Service Role Key (OPTIONAL - strictly server-side, never exposed to client):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Provider Keys (Optional - for custom live model inference)
# Specify ONE of the following targets:
# Option A: Target Database ID (32-character hex ID from your database URL)
NOTION_DATABASE_ID=your_32_character_database_id

# Option B: Target Parent Page ID (32-character hex ID from your parent page URL)
# NOTION_PARENT_PAGE_ID=your_32_character_parent_page_id

# ==============================================================================
# OPTIONAL LLM PROVIDER KEYS (For custom live model inference)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

