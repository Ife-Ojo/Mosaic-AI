# Mosaic AI — Multilingual Learning Companion for Notion
# (Optional) Server-side Credentials:
# Keep all API keys and credentials secure on the server side.
# Mosaic functions completely with rich built-in simulation and realistic sample content out of the box.

# Notion Integration (Optional - for live workspace sync)
NOTION_API_KEY=secret_your_internal_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Supabase PostgreSQL (Optional - for Notes Exchange persistence & sync)
# When omitted, Notes Exchange runs smoothly in explicitly labeled Demo Mode with sample notes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side Service Role Key (OPTIONAL - strictly server-side, never exposed to client):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Provider Keys (Optional - for custom live model inference)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

